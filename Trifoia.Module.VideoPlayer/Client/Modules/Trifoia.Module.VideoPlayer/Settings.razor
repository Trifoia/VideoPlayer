@namespace Trifoia.Module.VideoPlayer
@inherits ModuleBase


@if(!_loading){
    <div class="container">
        <div class="row mb-1 align-items-center">
            <label class="form-label col-sm-3" for="title">Title</label>
            <div class="col-sm-9">
                <input id="title" type="text" class="form-control" @bind="_settingsVM.Title" />
            </div>
        </div>

        <div class="row mb-1 align-items-center">
            <label class="form-label col-sm-3" for="source">Source</label>
            <div class="col-sm-9">
                <input id="source" type="text" class="form-control" @bind="_settingsVM.Source" />
            </div>
        </div>

        <div class="row mb-1 align-items-center">
            <label class="form-label col-sm-3" for="englishCaptions">English Captions</label>
            <div class="col-sm-9">
                <input id="englishCaptions" type="text" class="form-control" @bind="_settingsVM.EnglishCaptions" />
            </div>
        </div>

        <div class="row mb-1 align-items-center">
            <label class="form-label col-sm-3" for="spanishCaptions">Spanish Captions</label>
            <div class="col-sm-9">
                <input id="spanishCaptions" type="text" class="form-control" @bind="_settingsVM.SpanishCaptions" />
            </div>
        </div>
    </div>
}
