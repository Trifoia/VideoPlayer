@namespace Trifoia.Module.VideoPlayer
@inherits ModuleBase

@if (IsLoaded)
{
    <BlazoredVideo @ref="videoPlayer"
                    VideoEventOptions="options"
                    UseExternalJavaScript="false"
                    style="max-width:100%;"
                    controls="controls">
        <source src="@_settingsVM.Source"
                type="video/mp4" />
        @if (!String.IsNullOrEmpty(_settingsVM.EnglishCaptions))
        {
            <track label="English"
                    kind="subtitles"
                    srclang="en"
                    src="@_settingsVM.EnglishCaptions"
                    default />
        }
        @if (!String.IsNullOrEmpty(_settingsVM.SpanishCaptions))
        {
            <track label="Spanish"
                    kind="subtitles"
                    srclang="es"
                    src="@_settingsVM.SpanishCaptions" />
        }
    </BlazoredVideo>
}